FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "Flask>=3.0" "gunicorn>=22.0" "opencv-python-headless>=4.10" "numpy>=1.26" "google-genai>=1.0" "pydantic>=2.7" "Pillow>=10.0"

WORKDIR /opt/peix
RUN mkdir -p /opt/peix /data
RUN \
    printf '%s' '' > /tmp/peix.b64 && \
    printf '%s' '' >> /tmp/peix.b64 && \
    printf '%s' '' >> /tmp/peix.b64 && \
    printf '%s' '' >> /tmp/peix.b64 && \
    printf '%s' '' >> /tmp/peix.b64 && \
    printf '%s' '' >> /tmp/peix.b64 && \
    printf '%s' '' >> /tmp/peix.b64 && \
    python -c "import base64,zipfile; d=base64.b64decode(open('/tmp/peix.b64').read()); open('/tmp/peix.zip','wb').write(d); zipfile.ZipFile('/tmp/peix.zip').extractall('/opt/peix')" && \
    rm -f /tmp/peix.b64 /tmp/peix.zip

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    PEIX_TZ=Europe/Madrid \
    PEIX_USAGE_DB=/data/peix_usage.db \
    PEIX_WORK_DIR=/data/peix \
    MAX_DAILY_VEO_CALLS=1 \
    MAX_DAILY_PREPARES=2 \
    VISION_TIMEOUT_S=45 \
    VISION_MODEL=gemini-3.8-flash \
    IMAGE_MODEL=gemini-3.1-flash-image \
    VEO_MODEL=veo-3.1-fast-generate-preview

EXPOSE 8080
CMD ["gunicorn","--chdir","/opt/peix/app","--bind","0.0.0.0:8080","--workers","1","--timeout","600","app:app"]
